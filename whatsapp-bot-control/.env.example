# ==============================================================================
# Vyapaar WhatsApp Bot Server (.env)
# ==============================================================================

# Server Port (Railway, Render, and Heroku provide this automatically)
PORT=3001

# Google Gemini API Key (Required for voice note STT audio transcription)
# Get a key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name for audio transcription
GEMINI_MODEL=gemini-3.8-flash

# Sarvam AI Conversational Agent
# Dashboard: https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_AGENT_ID=whatsapp-ch-779ea7d0-dd9c

# OCR.space API Key (Photo to order extraction)
# Free key from: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=51c4e9533888957

# Merchant UPI VPA for Dynamic QR & Tap-to-Pay Links
UPI_VPA=cafevaidehi.demo@upi

# Default Store Configuration
STORE_NAME=The Daily Spice Café & Kitchen
STORE_CATEGORY=Restaurant & Cafe
DEFAULT_CURRENCY=INR

